---
import Base from "../layouts/Base.astro";
import Bi from "../components/Bi.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { FORK_GROUPS, KIND_LABEL, STATUS_LABEL, getCatalog } from "../lib/catalog";

const { site, modules, levels, projects, languages } = getCatalog();
const description = "按语言、模块、原创或 fork 筛选全部公开仓库。";
---

<Base title={`全部项目 · ${site.name.zh}`} description={description}>
  <section class="section page-intro">
    <header class="sec-head">
      <p class="num">∞</p>
      <div>
        <p class="kicker"><Bi zh="全部项目" en="All projects" /></p>
        <h1>
          <span class="zh">{projects.length} 个公开仓库，放在同一张桌子上</span>
          <span class="en">{projects.length} public repositories, on one table</span>
        </h1>
        <p class="lede">
          <Bi
            zh="可以按原创或 fork、模块、实验室分组、难度、语言和状态筛选，也可以搜索中英文标题。"
            en="Filter by original or fork, module, lab group, level, language, and status, or search titles in either language."
          />
        </p>
      </div>
    </header>
  </section>

  <div class="catalog" data-catalog>
    <form class="filters" onsubmit="return false">
      <label class="search">
        <span><Bi zh="搜索" en="Search" /></span>
        <input type="search" data-filter-search placeholder="创伤 / trauma / agent" />
      </label>
      <label>
        <span><Bi zh="来源" en="Origin" /></span>
        <select data-filter="kind">
          <option value="">全部 / All</option>
          <option value="original">{KIND_LABEL.original.zh} / {KIND_LABEL.original.en}</option>
          <option value="fork">{KIND_LABEL.fork.zh} / {KIND_LABEL.fork.en}</option>
        </select>
      </label>
      <label>
        <span><Bi zh="模块" en="Module" /></span>
        <select data-filter="module">
          <option value="">全部 / All</option>
          {modules.map((module) => (
            <option value={module.id}>{module.code} · {module.title.zh} / {module.title.en}</option>
          ))}
        </select>
      </label>
      <label>
        <span><Bi zh="实验室分组" en="Lab group" /></span>
        <select data-filter="group">
          <option value="">全部 / All</option>
          {Object.entries(FORK_GROUPS).map(([id, label]) => (
            <option value={id}>{label.zh} / {label.en}</option>
          ))}
        </select>
      </label>
      <label>
        <span><Bi zh="难度" en="Level" /></span>
        <select data-filter="level">
          <option value="">全部 / All</option>
          {levels.map((level) => (
            <option value={level.id}>{level.id} · {level.title.zh} / {level.title.en}</option>
          ))}
        </select>
      </label>
      <label>
        <span><Bi zh="语言" en="Language" /></span>
        <select data-filter="language">
          <option value="">全部 / All</option>
          {languages.map((language) => (
            <option value={language}>{language === "none" ? "未标注 / Unspecified" : language}</option>
          ))}
        </select>
      </label>
      <label>
        <span><Bi zh="状态" en="Status" /></span>
        <select data-filter="status">
          <option value="">全部 / All</option>
          {Object.entries(STATUS_LABEL).map(([id, label]) => (
            <option value={id}>{label.zh} / {label.en}</option>
          ))}
        </select>
      </label>
      <button class="btn" type="button" data-reset><Bi zh="清除" en="Clear" /></button>
      <p class="count">
        <span class="zh">显示 <b data-shown>{projects.length}</b> / {projects.length}</span>
        <span class="en">Showing <b data-shown>{projects.length}</b> / {projects.length}</span>
      </p>
    </form>
    <p class="empty-filter" data-empty hidden>
      <Bi zh="没有符合的项目。清除筛选再试。" en="Nothing matches. Clear the filters and try again." />
    </p>
    <noscript>
      <p><Bi zh="不运行脚本时，下面是完整名单，筛选不可用。" en="Without JavaScript the full list is shown and the filters do nothing." /></p>
    </noscript>
    <div class="cards">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
  <script>
    import "../scripts/filters";
  </script>
</Base>
